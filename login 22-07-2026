<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Test Optimization</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --brand-red: #E8291C;
    --brand-red-dark: #C21E13;
    --brand-red-light: #FDEAE8;
    --ink: #1A2233;
    --ink-soft: #5B6472;
    --line: #E7E5E9;
    --paper: #FFFFFF;
    --bg-1: #FBFAF9;
    --error-bg: #FDF1F1;
    --error-line: #F3C9C6;
    --error-text: #B4271C;
    --focus-ring: rgba(232,41,28,0.16);
  }

  *{ box-sizing: border-box; }

  html, body{
    height: 100%;
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
    color: var(--ink);
    background: var(--bg-1);
    overflow-x: hidden;
  }

  .stage{
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    perspective: 1200px;
  }


  .card-wrap{
    position: relative;
    width: 100%;
    max-width: 420px;
    border-radius: 22px;
    padding: 1.5px;
    opacity: 0;
    transform: translateY(18px);
    animation: card-in 0.7s cubic-bezier(.2,.7,.2,1) forwards;
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out;
    will-change: transform;
  }
  .card-wrap::before{
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 22px;
    padding: 1.5px;
    background: conic-gradient(from var(--angle,0deg), transparent 0%, var(--brand-red) 12%, transparent 28%, transparent 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: border-spin 5s linear infinite;
  }
  @keyframes border-spin{
    to{ --angle: 360deg; }
  }
  @property --angle{
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .card{
    position: relative;
    z-index: 1;
    width: 100%;
    background: var(--paper);
    border-radius: 20px;
    border: 1px solid var(--line);
    box-shadow: 0 1px 2px rgba(20,15,15,0.04), 0 24px 60px -20px rgba(180,30,20,0.16);
    padding: 40px 36px 34px;
    transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
    transform-style: preserve-3d;
  }

  @keyframes card-in{
    to{ opacity: 1; transform: translateY(0); }
  }

  .stagger > *{
    opacity: 0;
    transform: translateY(10px);
    animation: item-in 0.55s ease forwards;
  }
  .stagger > *:nth-child(1){ animation-delay: 0.15s; }
  .stagger > *:nth-child(2){ animation-delay: 0.22s; }
  .stagger > *:nth-child(3){ animation-delay: 0.29s; }
  .stagger > *:nth-child(4){ animation-delay: 0.36s; }
  .stagger > *:nth-child(5){ animation-delay: 0.43s; }
  .stagger > *:nth-child(6){ animation-delay: 0.50s; }
  .stagger > *:nth-child(7){ animation-delay: 0.57s; }

  @keyframes item-in{
    to{ opacity: 1; transform: translateY(0); }
  }

  /* logo mark */
  .logo-wrap{
    display: flex;
    justify-content: center;
    margin-bottom: 18px;
  }
  .logo{
    width: 68px;
    height: 68px;
    border-radius: 18px;
    background: linear-gradient(150deg, var(--brand-red), var(--brand-red-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 10px 22px -8px rgba(232,41,28,0.55);
    animation: logo-pop 0.8s cubic-bezier(.34,1.56,.64,1) 0.1s both;
  }
  @keyframes logo-pop{
    0%{ transform: scale(0.3) rotate(-25deg); opacity: 0; }
    60%{ transform: scale(1.08) rotate(4deg); opacity: 1; }
    100%{ transform: scale(1) rotate(0deg); }
  }
  .logo svg{
    width: 34px;
    height: 34px;
    overflow: visible;
  }
  .logo .lg-path{
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: draw-path 1s ease forwards 0.55s;
  }
  .logo .lg-check{
    fill: none;
    stroke: #fff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 20;
    stroke-dashoffset: 20;
    animation: draw-path 0.5s ease forwards 1.35s;
  }
  @keyframes draw-path{
    to{ stroke-dashoffset: 0; }
  }
  .logo::after{
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 20px;
    border: 1.5px solid var(--brand-red);
    opacity: 0.35;
    animation: ring-pulse 2.6s ease-out infinite;
  }
  @keyframes ring-pulse{
    0% { transform: scale(0.9); opacity: 0.5; }
    80% { transform: scale(1.25); opacity: 0; }
    100% { opacity: 0; }
  }

  .eyebrow{
    text-align: center;
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 2.2px;
    color: var(--brand-red);
    margin: 0 0 6px;
  }
  .caret{
    display: inline-block;
    width: 2px;
    height: 11px;
    background: var(--brand-red);
    margin-left: 3px;
    vertical-align: -1px;
    animation: blink 1s step-end infinite;
  }
  @keyframes blink{
    0%, 100%{ opacity: 1; }
    50%{ opacity: 0; }
  }

  h1{
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 26px;
    line-height: 1.2;
    text-align: center;
    margin: 0 0 10px;
    color: var(--ink);
    letter-spacing: -0.3px;
  }

  .desc{
    text-align: center;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 26px;
    padding: 0 6px;
  }

  label{
    display: block;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 7px;
  }

  .field-group{ margin-bottom: 16px; }

  .input-shell{
    position: relative;
  }
  .input-shell::after, .pw-row::after{
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 0;
    height: 2px;
    background: var(--brand-red);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
    pointer-events: none;
  }
  .input-shell:focus-within::after, .pw-row:focus-within::after{
    transform: scaleX(1);
  }

  input[type="text"], input[type="password"]{
    width: 100%;
    padding: 13px 14px;
    font-size: 14.5px;
    font-family: 'Inter', sans-serif;
    border-radius: 11px;
    border: 1.5px solid var(--line);
    background: #FCFCFB;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  input[type="text"]:focus, input[type="password"]:focus{
    border-color: var(--brand-red);
    background: #fff;
    box-shadow: 0 0 0 4px var(--focus-ring);
  }

  input::placeholder{ color: #A8ACB4; }

  .pw-row{
    position: relative;
    display: flex;
    align-items: center;
  }
  .pw-row input{ padding-right: 64px; }

  .show-btn{
    position: absolute;
    right: 8px;
    background: none;
    border: none;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--brand-red);
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 6px;
    transition: background 0.15s ease;
  }
  .show-btn:hover{ background: var(--brand-red-light); }

  .row-between{
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 2px 0 18px;
  }

  .remember{
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--ink-soft);
    cursor: pointer;
    user-select: none;
  }

  .remember input{
    width: 15px;
    height: 15px;
    accent-color: var(--brand-red);
    cursor: pointer;
  }

  .forgot{
    font-size: 13px;
    font-weight: 600;
    color: var(--brand-red);
    text-decoration: none;
  }
  .forgot:hover{ text-decoration: underline; }

  .error-box{
    display: none;
    align-items: flex-start;
    gap: 8px;
    background: var(--error-bg);
    border: 1px solid var(--error-line);
    color: var(--error-text);
    font-size: 12.5px;
    line-height: 1.5;
    padding: 10px 12px;
    border-radius: 10px;
    margin-bottom: 16px;
    animation: shake 0.45s ease;
  }
  .error-box.show{ display: flex; }

  @keyframes shake{
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-4px); }
    40%, 60% { transform: translateX(4px); }
  }

  .signin-btn{
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 11px;
    background: linear-gradient(135deg, var(--brand-red), var(--brand-red-dark));
    color: white;
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 24px -10px rgba(200,25,15,0.55);
  }
  .signin-btn:hover{ transform: translateY(-1px); box-shadow: 0 14px 28px -10px rgba(200,25,15,0.6); }
  .signin-btn:active{ transform: translateY(0); }

  .btn-label{
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.2s ease;
  }
  .btn-arrow{
    display: inline-block;
    transform: translateX(-4px);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .signin-btn:hover .btn-arrow{
    transform: translateX(0);
    opacity: 1;
  }

  .signin-btn .ripple{
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,0.45);
    transform: scale(0);
    animation: ripple-anim 0.6s ease-out;
    pointer-events: none;
  }
  @keyframes ripple-anim{
    to{ transform: scale(3.5); opacity: 0; }
  }

  .signin-btn.loading .btn-label{ opacity: 0; }
  .spinner{
    position: absolute;
    top: 50%; left: 50%;
    width: 18px; height: 18px;
    margin: -9px 0 0 -9px;
    border: 2.5px solid rgba(255,255,255,0.4);
    border-top-color: #fff;
    border-radius: 50%;
    opacity: 0;
    animation: none;
  }
  .signin-btn.loading .spinner{
    opacity: 1;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin{ to{ transform: rotate(360deg); } }

  .footnote{
    text-align: center;
    font-size: 12px;
    color: #9AA0AA;
    margin-top: 18px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation: none !important; transition: none !important; }
  }

  @media (max-width: 480px){
    .card{ padding: 32px 24px 28px; border-radius: 16px; }
    h1{ font-size: 22px; }
  }

  /* =========================================================
     DASHBOARD (new) — same token system as the login card
  ========================================================= */
  #dashboardStage{ display: none; }
  #dashboardStage.show{ display: block; }

  .dash-shell{
    min-height: 100vh;
    background: var(--bg-1);
  }

  .dash-topbar{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 28px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 5;
  }

  .dash-brand{
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .dash-logo{
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(150deg, var(--brand-red), var(--brand-red-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 14px -6px rgba(232,41,28,0.5);
  }
  .dash-logo svg{ width: 18px; height: 18px; }
  .dash-brand-text{
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }
  .dash-brand-sub{
    font-size: 11px;
    color: var(--ink-soft);
    letter-spacing: 0.4px;
  }

  .dash-user{
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dash-user-name{
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .logout-btn{
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink-soft);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 12.5px;
    padding: 8px 14px;
    border-radius: 9px;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .logout-btn:hover{ border-color: var(--brand-red); color: var(--brand-red); }

  .dash-main{
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 28px 60px;
  }

  .dash-heading{
    margin-bottom: 28px;
  }
  .dash-heading h2{
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 24px;
    margin: 0 0 6px;
    color: var(--ink);
    letter-spacing: -0.3px;
  }
  .dash-heading p{
    font-size: 13.5px;
    color: var(--ink-soft);
    margin: 0;
  }

  .dash-grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  @media (max-width: 880px){
    .dash-grid{ grid-template-columns: 1fr; }
  }

  .dash-card{
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px 26px 24px;
    box-shadow: 0 1px 2px rgba(20,15,15,0.04);
    display: flex;
    flex-direction: column;
  }

  .dash-card-tag{
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 10.5px;
    letter-spacing: 1.6px;
    color: var(--brand-red);
    margin-bottom: 10px;
  }
  .dash-card-tag .dot{
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--brand-red);
  }

  .dash-card h3{
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 17.5px;
    margin: 0 0 6px;
    color: var(--ink);
  }
  .dash-card > p.dash-card-desc{
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.5;
    margin: 0 0 20px;
  }

  .dash-field{ margin-bottom: 14px; }
  .dash-field label{ font-size: 12px; }

  textarea.dash-textarea, input.dash-input{
    width: 100%;
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    border-radius: 11px;
    border: 1.5px solid var(--line);
    background: #FCFCFB;
    color: var(--ink);
    outline: none;
    padding: 12px 13px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    resize: vertical;
  }
  textarea.dash-textarea{ min-height: 96px; line-height: 1.5; }
  textarea.dash-textarea:focus, input.dash-input:focus{
    border-color: var(--brand-red);
    background: #fff;
    box-shadow: 0 0 0 4px var(--focus-ring);
  }
  textarea.dash-textarea::placeholder, input.dash-input::placeholder{ color: #A8ACB4; }

  .dash-action-btn{
    width: 100%;
    padding: 12.5px;
    border: none;
    border-radius: 11px;
    background: linear-gradient(135deg, var(--brand-red), var(--brand-red-dark));
    color: #fff;
    font-family: 'Sora', sans-serif;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    margin-top: 4px;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 20px -10px rgba(200,25,15,0.5);
  }
  .dash-action-btn:hover{ transform: translateY(-1px); }
  .dash-action-btn:disabled{ opacity: 0.6; cursor: not-allowed; transform: none; }

  .dash-action-btn .spinner{
    position: absolute; top: 50%; left: 50%;
    width: 16px; height: 16px; margin: -8px 0 0 -8px;
    border: 2.2px solid rgba(255,255,255,0.4);
    border-top-color: #fff; border-radius: 50%;
    opacity: 0; animation: none;
  }
  .dash-action-btn.loading .btn-label{ opacity: 0; }
  .dash-action-btn.loading .spinner{ opacity: 1; animation: spin 0.7s linear infinite; }

  .dash-results{
    margin-top: 18px;
    display: none;
  }
  .dash-results.show{ display: block; animation: item-in 0.4s ease forwards; }

  .dash-result-box{
    background: #FCFCFB;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 10px;
  }
  .dash-result-box h4{
    font-family: 'Sora', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
    margin: 0 0 8px;
    color: var(--ink);
    text-transform: uppercase;
  }
  .dash-result-box ul{
    margin: 0; padding-left: 18px;
  }
  .dash-result-box li{
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .dash-result-box li strong{ color: var(--ink); }

  .dup-line{
    font-size: 13px;
    padding: 8px 10px;
    border-radius: 8px;
    margin-bottom: 6px;
    background: #FCFCFB;
    border: 1px solid var(--line);
    color: var(--ink);
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .dup-line.is-dupe{
    background: var(--error-bg);
    border-color: var(--error-line);
    color: var(--error-text);
  }
  .dup-line .count-pill{
    font-size: 11px;
    font-weight: 700;
    background: var(--brand-red);
    color: #fff;
    padding: 2px 8px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .dup-line.is-unique .count-pill{ background: #9AA0AA; }

  .dash-empty-note{
    font-size: 12px;
    color: var(--ink-soft);
    background: var(--brand-red-light);
    border: 1px dashed var(--brand-red);
    border-radius: 10px;
    padding: 9px 11px;
    margin-top: 4px;
  }

  .dash-summary-row{
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .dash-stat{
    flex: 1;
    min-width: 90px;
    background: #FCFCFB;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    text-align: center;
  }
  .dash-stat .num{
    font-family: 'Sora', sans-serif;
    font-weight: 800;
    font-size: 20px;
    color: var(--brand-red);
    display: block;
  }
  .dash-stat .lbl{
    font-size: 10.5px;
    color: var(--ink-soft);
    letter-spacing: 0.3px;
  }
</style>
</head>
<body>

<!-- ================= LOGIN PAGE (unchanged) ================= -->
<div class="stage" id="loginStage">
<div class="card-wrap">
   <div class="card">
    <div class="stagger">
      <div class="logo-wrap">
        <div class="logo">
          <svg viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path class="lg-path" d="M17 2.5 L29.5 8 V17 C29.5 24.5 24 29 17 31.5 C10 29 4.5 24.5 4.5 17 V8 Z"/>
            <path class="lg-check" d="M11 17.5 L15 21.5 L23.5 12"/>
          </svg>
        </div>
      </div>

      <p class="eyebrow">TEST OPTIMIZATION<span class="caret"></span></p>
      <h1>Sign in to your workspace</h1>
      <p class="desc">Identifying missed scenarios, removing redundant test cases, and test script maintenance.</p>

      <form id="loginForm" novalidate>
        <div class="field-group">
          <label for="username">Username or Email</label>
          <div class="input-shell">
            <input type="text" id="username" name="username" placeholder="you@company.com" autocomplete="username" required>
          </div>
        </div>

        <div class="field-group">
          <label for="password">Password</label>
          <div class="pw-row">
            <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>
            <button type="button" class="show-btn" id="toggleShow">Show</button>
          </div>
        </div>

        <div class="row-between">
          <label class="remember">
            <input type="checkbox" id="remember">
            Remember me
          </label>
          <a href="#" class="forgot">Forgot password?</a>
        </div>

        <div class="error-box" id="errorBox">
          <span>Authentication service error. Please try again shortly.</span>
        </div>

        <button type="submit" class="signin-btn" id="signinBtn">
          <span class="btn-label">Sign In <span class="btn-arrow">→</span></span>
          <span class="spinner"></span>
        </button>

        <p class="footnote">Protected workspace · Secure connection</p>
      </form>
    </div>
   </div>
  </div>
</div>

<!-- ================= DASHBOARD (new) ================= -->
<div id="dashboardStage">
  <div class="dash-shell">
    <div class="dash-topbar">
      <div class="dash-brand">
        <div class="dash-logo">
          <svg viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17 2.5 L29.5 8 V17 C29.5 24.5 24 29 17 31.5 C10 29 4.5 24.5 4.5 17 V8 Z" stroke="#fff" stroke-width="2.6" fill="none"/>
            <path d="M11 17.5 L15 21.5 L23.5 12" stroke="#fff" stroke-width="2.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <div class="dash-brand-text">Test Optimization</div>
          <div class="dash-brand-sub">Workspace</div>
        </div>
      </div>
      <div class="dash-user">
        <span class="dash-user-name" id="dashUserName">Welcome back</span>
        <button class="logout-btn" id="logoutBtn">Log out</button>
      </div>
    </div>

    <div class="dash-main">
      <div class="dash-heading">
        <h2>What do you want to check?</h2>
        <p>Pick one of the two tools below. Both run entirely in this page.</p>
      </div>

      <div class="dash-grid">

        <!-- OPTION 1: Requirement + Test Case Analyzer -->
        <div class="dash-card">
          <span class="dash-card-tag"><span class="dot"></span>OPTION 1</span>
          <h3>Requirement &amp; Test Case Analyzer</h3>
          <p class="dash-card-desc">Paste the requirement and the test case link. We'll flag scenarios the test cases may be missing.</p>

          <div class="dash-field">
            <label for="reqText">Requirement</label>
            <textarea class="dash-textarea" id="reqText" placeholder="Paste or type the requirement text here…"></textarea>
          </div>

          <div class="dash-field">
            <label for="tcLink">Test Case Link</label>
            <input class="dash-input" type="text" id="tcLink" placeholder="https://your-tool.com/testcases/123">
          </div>

          <button class="dash-action-btn" id="analyzeBtn" type="button">
            <span class="btn-label">Analyze</span>
            <span class="spinner"></span>
          </button>

          <div class="dash-results" id="analyzeResults">
            <div class="dash-summary-row" id="analyzeSummary"></div>
            <div class="dash-result-box">
              <h4>Potential gaps</h4>
              <ul id="analyzeGaps"></ul>
            </div>
            <div class="dash-result-box">
              <h4>Suggested test scenarios</h4>
              <ul id="analyzeSuggestions"></ul>
            </div>
          </div>
        </div>

        <!-- OPTION 2: Test Case Duplicate Checker -->
        <div class="dash-card">
          <span class="dash-card-tag"><span class="dot"></span>OPTION 2</span>
          <h3>Test Case Duplicate Checker</h3>
          <p class="dash-card-desc">Paste your test cases, one per line. We'll highlight which ones repeat.</p>

          <div class="dash-field">
            <label for="dupText">Test Cases (one per line)</label>
            <textarea class="dash-textarea" id="dupText" style="min-height:150px" placeholder="TC01: Verify login with valid credentials
TC02: Verify login with invalid password
TC01: Verify login with valid credentials"></textarea>
          </div>

          <button class="dash-action-btn" id="dupBtn" type="button">
            <span class="btn-label">Check Duplicates</span>
            <span class="spinner"></span>
          </button>

          <div class="dash-results" id="dupResults">
            <div class="dash-summary-row" id="dupSummary"></div>
            <div id="dupList"></div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  /* ---------- Login page behavior (unchanged visuals; routes to dashboard) ---------- */
  const toggleShow = document.getElementById('toggleShow');
  const passwordInput = document.getElementById('password');
  toggleShow.addEventListener('click', () => {
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
    toggleShow.textContent = isPassword ? 'Hide' : 'Show';
  });

  const form = document.getElementById('loginForm');
  const btn = document.getElementById('signinBtn');
  const errorBox = document.getElementById('errorBox');
  const loginStage = document.getElementById('loginStage');
  const dashboardStage = document.getElementById('dashboardStage');
  const dashUserName = document.getElementById('dashUserName');

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (btn.classList.contains('loading')) return;

    const username = document.getElementById('username').value.trim();
    const password = document.getElementById('password').value.trim();

    errorBox.classList.remove('show');

    if (!username || !password) {
      btn.classList.add('loading');
      setTimeout(() => {
        btn.classList.remove('loading');
        void errorBox.offsetWidth;
        errorBox.classList.remove('show');
        requestAnimationFrame(() => errorBox.classList.add('show'));
      }, 700);
      return;
    }

    // TODO: replace with a real authentication call.
    // On success, we route to the dashboard.
    btn.classList.add('loading');
    setTimeout(() => {
      btn.classList.remove('loading');
      loginStage.style.display = 'none';
      dashboardStage.classList.add('show');
      dashUserName.textContent = 'Signed in as ' + username;
    }, 900);
  });

  btn.addEventListener('click', function(e) {
    const rect = btn.getBoundingClientRect();
    const ripple = document.createElement('span');
    const size = Math.max(rect.width, rect.height);
    ripple.className = 'ripple';
    ripple.style.width = ripple.style.height = size + 'px';
    ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
    ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
    btn.appendChild(ripple);
    setTimeout(() => ripple.remove(), 650);
  });

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isFinePointer = window.matchMedia('(pointer: fine)').matches;
  if (!prefersReduced && isFinePointer) {
    const wrap = document.querySelector('.card-wrap');
    const card = document.querySelector('.card');
    wrap.addEventListener('mousemove', (e) => {
      const rect = wrap.getBoundingClientRect();
      const px = (e.clientX - rect.left) / rect.width - 0.5;
      const py = (e.clientY - rect.top) / rect.height - 0.5;
      card.style.transform = `rotateY(${px * 6}deg) rotateX(${-py * 6}deg) translateZ(0)`;
    });
    wrap.addEventListener('mouseleave', () => {
      card.style.transform = 'rotateY(0deg) rotateX(0deg)';
    });
  }

  /* ---------- Logout ---------- */
  document.getElementById('logoutBtn').addEventListener('click', () => {
    dashboardStage.classList.remove('show');
    loginStage.style.display = 'flex';
    form.reset();
    errorBox.classList.remove('show');
  });

  /* ---------- OPTION 1: Requirement & Test Case Analyzer ---------- */
  const analyzeBtn = document.getElementById('analyzeBtn');
  const reqText = document.getElementById('reqText');
  const tcLink = document.getElementById('tcLink');
  const analyzeResults = document.getElementById('analyzeResults');
  const analyzeSummary = document.getElementById('analyzeSummary');
  const analyzeGaps = document.getElementById('analyzeGaps');
  const analyzeSuggestions = document.getElementById('analyzeSuggestions');

  function splitRequirementIntoClauses(text){
    return text
      .split(/(?<=[.!?])\s+|\n+/)
      .map(s => s.trim())
      .filter(s => s.length > 8);
  }

  // Words that usually signal a distinct, testable condition worth its own test case.
  const CONDITION_SIGNALS = [
    'if', 'when', 'unless', 'must', 'should', 'shall', 'only', 'valid', 'invalid',
    'error', 'empty', 'null', 'maximum', 'minimum', 'required', 'optional',
    'timeout', 'duplicate', 'concurrent', 'permission', 'unauthorized', 'expired'
  ];

  analyzeBtn.addEventListener('click', () => {
    if (analyzeBtn.classList.contains('loading')) return;

    const requirement = reqText.value.trim();
    const link = tcLink.value.trim();

    if (!requirement || !link) {
      analyzeResults.classList.remove('show');
      analyzeSummary.innerHTML = '<div class="dash-empty-note">Please fill in both the requirement and the test case link before analyzing.</div>';
      analyzeResults.classList.add('show');
      analyzeGaps.innerHTML = '';
      analyzeSuggestions.innerHTML = '';
      return;
    }

    analyzeBtn.classList.add('loading');
    analyzeBtn.disabled = true;

    // NOTE: this is a client-side heuristic preview.
    // Wire this up to your real analysis backend, passing `requirement` and `link`.
    setTimeout(() => {
      const clauses = splitRequirementIntoClauses(requirement);
      const flagged = clauses.filter(c => {
        const lower = c.toLowerCase();
        return CONDITION_SIGNALS.some(sig => lower.includes(sig));
      });
      const gaps = flagged.length ? flagged.slice(0, 6) : clauses.slice(0, 3);

      analyzeSummary.innerHTML = `
        <div class="dash-stat"><span class="num">${clauses.length}</span><span class="lbl">CLAUSES FOUND</span></div>
        <div class="dash-stat"><span class="num">${gaps.length}</span><span class="lbl">POSSIBLE GAPS</span></div>
        <div class="dash-stat"><span class="num">✓</span><span class="lbl">LINK RECEIVED</span></div>
      `;

      analyzeGaps.innerHTML = gaps.length
        ? gaps.map(g => `<li><strong>Check:</strong> ${escapeHtml(g)}</li>`).join('')
        : '<li>No obvious gaps detected from the requirement text alone.</li>';

      analyzeSuggestions.innerHTML = gaps.length
        ? gaps.map(g => `<li>Add a test case verifying: <strong>${escapeHtml(g)}</strong></li>`).join('')
        : '<li>Existing coverage looks reasonable — consider a manual review of edge cases.</li>';

      analyzeResults.classList.add('show');
      analyzeBtn.classList.remove('loading');
      analyzeBtn.disabled = false;
    }, 900);
  });

  /* ---------- OPTION 2: Test Case Duplicate Checker ---------- */
  const dupBtn = document.getElementById('dupBtn');
  const dupText = document.getElementById('dupText');
  const dupResults = document.getElementById('dupResults');
  const dupSummary = document.getElementById('dupSummary');
  const dupList = document.getElementById('dupList');

  function normalizeLine(line){
    return line
      .toLowerCase()
      .replace(/^\s*(tc[\s\-_]?\d+\s*[:.\-]?\s*)/i, '') // strip leading "TC01:" style ids
      .replace(/[^\w\s]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function escapeHtml(str){
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  dupBtn.addEventListener('click', () => {
    if (dupBtn.classList.contains('loading')) return;

    const raw = dupText.value.split('\n').map(l => l.trim()).filter(Boolean);

    if (!raw.length) {
      dupResults.classList.remove('show');
      dupSummary.innerHTML = '<div class="dash-empty-note">Paste at least a couple of test cases (one per line) to check for duplicates.</div>';
      dupResults.classList.add('show');
      dupList.innerHTML = '';
      return;
    }

    dupBtn.classList.add('loading');
    dupBtn.disabled = true;

    setTimeout(() => {
      const counts = {};
      raw.forEach(line => {
        const key = normalizeLine(line);
        counts[key] = (counts[key] || 0) + 1;
      });

      const duplicateGroups = Object.keys(counts).filter(k => counts[k] > 1).length;
      const totalDuplicateLines = raw.filter(line => counts[normalizeLine(line)] > 1).length;

      dupSummary.innerHTML = `
        <div class="dash-stat"><span class="num">${raw.length}</span><span class="lbl">TOTAL LINES</span></div>
        <div class="dash-stat"><span class="num">${duplicateGroups}</span><span class="lbl">DUPLICATE GROUPS</span></div>
        <div class="dash-stat"><span class="num">${totalDuplicateLines}</span><span class="lbl">LINES INVOLVED</span></div>
      `;

      dupList.innerHTML = raw.map(line => {
        const key = normalizeLine(line);
        const count = counts[key];
        const isDupe = count > 1;
        return `<div class="dup-line ${isDupe ? 'is-dupe' : 'is-unique'}">
          <span>${escapeHtml(line)}</span>
          <span class="count-pill">${isDupe ? 'duplicate ×' + count : 'unique'}</span>
        </div>`;
      }).join('');

      dupResults.classList.add('show');
      dupBtn.classList.remove('loading');
      dupBtn.disabled = false;
    }, 700);
  });
</script>

</body>
</html>