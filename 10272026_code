    if new is not None and sig != st.session_state.get("tr_sig"):
        set_testrun(new, sig)
    df = st.session_state.get("tr_df")
    if df is None:
        st.info("Upload a test run sheet to see the analysis. Use “Header row” if your column "
                "names are not in row 1.")
        return
    st.caption(f"✅ {st.session_state.tr_name} · {len(df):,} rows · {len(df.columns)} columns")

    cols = list(df.columns)
    section("2 · Choose the columns")
    c1, c2 = st.columns(2)
    id_col = c1.selectbox(
        "Test case ID column", cols, key="cnt_id",
        index=guess(cols, ["test case id", "testcase id", "tc id", "test case", "testcase", "id"]),
    )
    status_col = c2.selectbox(
        "Status / result column", cols, key="cnt_status",
        index=guess(cols, ["status", "result", "verdict", "outcome"], default=1),
    )
    if id_col == status_col:
        st.warning("The ID column and the status column are the same. Pick different columns.")

    valid = df[df[id_col].notna()].copy()
    if valid.empty:
        st.warning("No test cases found: the chosen ID column is empty.")
        return
    status = valid[status_col].fillna("(blank)").astype(str).str.strip().replace("", "(blank)")
    values = sorted(status.unique())

    section("3 · Map statuses to groups")
    st.caption("RunPilot guessed these from the words in your sheet. Change them if your sheet "
               "uses different words.")
    kb = f"{abs(hash(st.session_state.tr_sig))}_{status_col}"
    m1, m2, m3 = st.columns(3)
    pass_sel = m1.multiselect(
        "✅ Count as Pass", values, key=f"mp_{kb}",
        default=[v for v in values if "pass" in v.lower() and "recover" not in v.lower()])
    fail_sel = m2.multiselect(
        "❌ Count as Fail", values, key=f"mf_{kb}",
        default=[v for v in values if "fail" in v.lower() and "recover" not in v.lower()])
    rec_sel = m3.multiselect(
        "♻️ Count as Recovered", values, key=f"mr_{kb}",
        default=[v for v in values if "recover" in v.lower()])

    def group_of(v):
        if v in rec_sel:
            return "Recovered"
        if v in fail_sel:
            return "Fail"
        if v in pass_sel:
            return "Pass"
        return "Others"

    group = status.map(group_of)
    counts = group.value_counts().reindex(GROUPS, fill_value=0)
    total = len(valid)
    unique_ids = valid[id_col].nunique()
    passed, failed, recovered, others = (int(counts[g]) for g in GROUPS)

    def pct(n):
        return f"{n / total * 100:.1f}% of total"

    section("Results")
    kpi_row([
        ("Total test cases", f"{total:,}", INDIGO, f"{unique_ids:,} unique IDs"),
        ("Passed", f"{passed:,}", GROUP_COLOR["Pass"], pct(passed)),
        ("Failed", f"{failed:,}", GROUP_COLOR["Fail"], pct(failed)),
        ("Recovered", f"{recovered:,}", GROUP_COLOR["Recovered"], pct(recovered)),
        ("Pass rate", f"{passed / total * 100:.1f}%", TEAL,
         f"{(passed + recovered) / total * 100:.1f}% incl. recovered · {others:,} others"),
    ])

    t_over, t_rec, t_rows = st.tabs(["📈 Overview", "♻️ Recovered", "🔎 Browse & select row"])

    with t_over:
        left, right = st.columns([1, 1.25])
        gdf = pd.DataFrame({"Group": GROUPS, "Count": [int(counts[g]) for g in GROUPS]})
        with left:
            st.markdown("**Result split**")
            st.altair_chart(donut_chart(gdf[gdf["Count"] > 0], total))
        with right:
            st.markdown("**Count by status value**")
            sdf = status.value_counts().rename_axis("Status").reset_index(name="Count").head(15)
            sdf["Group"] = sdf["Status"].map(group_of)
            st.altair_chart(status_bar_chart(sdf))

        summary = gdf.copy()
        summary["Share"] = (summary["Count"] / total * 100).round(1).astype(str) + " %"
        st.dataframe(summary, hide_index=True)

        by = st.selectbox("Break down by another column (optional)",
                          ["(none)"] + [c for c in cols if c not in (id_col, status_col)],
                          key="cnt_by")
        if by != "(none)":
            d = pd.DataFrame({
                "Category": valid[by].fillna("(blank)").astype(str).values,
                "Group": group.values,
            })
            d = d[d["Category"].isin(d["Category"].value_counts().head(20).index)]
            g = d.groupby(["Category", "Group"]).size().reset_index(name="Count")
            st.altair_chart(stacked_chart(g))

    with t_rec:
        rec_rows = valid[group == "Recovered"]
        if rec_rows.empty:
            st.info("No recovered test cases yet. If your sheet uses another word for recovered, "
                    "add that status value under “Count as Recovered” above.")
        else:
            st.success(f"{len(rec_rows):,} test cases are marked as recovered "
                       f"({', '.join(rec_sel)}).")
            st.dataframe(rec_rows, hide_index=True)
            st.download_button("⬇ Download recovered test cases", to_excel_bytes(rec_rows),
                               file_name="recovered_test_cases.xlsx")

    with t_rows:
        choice = st.radio("Show", ["All"] + GROUPS, horizontal=True, key="cnt_filter")
        view = valid.copy()
        view.insert(0, "#", view.index + 1)
        view["Result group"] = group
        if choice != "All":
            view = view[view["Result group"] == choice]
        view = view.reset_index(drop=True)
        if view.empty:
            st.info("No rows in this group.")
        else:
            st.caption("Tick the checkbox at the start of a row to see that line's full data below.")
            pos = None
            try:
                event = st.dataframe(view, hide_index=True, on_select="rerun",
                                     selection_mode="single-row", key="cnt_tbl")
                picked = event.selection.rows
                pos = picked[0] if picked else None
            except TypeError:  # older Streamlit without row selection
                st.dataframe(view, hide_index=True)
                n = st.number_input("Row # to view", min_value=1, value=1, step=1)
                match = view.index[view["#"] == n]
                pos = match[0] if len(match) else None
            if pos is not None and pos < len(view):
                row_card(view.iloc[pos])


# ------------------------------------------------------------------ page: vlookup
def page_vlookup():
    page_header("VLOOKUP",
                "Bring data from the original sheet into the test run sheet, "
                "just like =VLOOKUP(test case ID, original range, column index, 0).")
    flash = st.session_state.pop("flash", None)
    if flash:
        st.success(flash)

    section("1 · Upload both sheets")
    c1, c2 = st.columns(2)
    with c1:
        st.markdown("**Original sheet** · the data you want to bring in")
        new, sig = read_sheet("orig", "Upload the original sheet")
        if new is not None and sig != st.session_state.get("orig_sig"):
            st.session_state.update(orig_df=new, orig_sig=sig, orig_name=sig[0])
        if st.session_state.get("orig_df") is not None:
            o = st.session_state.orig_df
            st.caption(f"✅ {st.session_state.orig_name} · {len(o):,} rows · {len(o.columns)} columns")
    with c2:
        st.markdown("**Test run sheet** · where the data will be added")
        new, sig = read_sheet("trv", "Upload the test run sheet")
        if new is not None and sig != st.session_state.get("tr_sig"):
            set_testrun(new, sig)
        if st.session_state.get("tr_df") is not None:
            t = st.session_state.tr_df
            st.caption(f"✅ {st.session_state.tr_name} · {len(t):,} rows · {len(t.columns)} columns")

    orig, tr = st.session_state.get("orig_df"), st.session_state.get("tr_df")
    if orig is None or tr is None:
        st.info("Upload both sheets to continue.")
        return

    or_cols, tr_cols = list(orig.columns), list(tr.columns)
    id_guess = ["test case id", "testcase id", "tc id", "test case", "testcase", "id"]

    section("2 · Build the formula")
    a, b, c, d = st.columns([1.3, 1.3, 1.3, 0.8])
    look_col = a.selectbox("Lookup value: test case ID (test run sheet)", tr_cols,
                           index=guess(tr_cols, id_guess), key="vl_look")
    start = b.selectbox("Table range starts at (original sheet key column)", or_cols,
                        index=guess(or_cols, id_guess), key="vl_start")
    start_i = or_cols.index(start)
    end_options = or_cols[start_i:]
    end = c.selectbox("Table range ends at (original sheet)", end_options,
                      index=len(end_options) - 1, key=f"vl_end_{start}")
    end_i = start_i + end_options.index(end)
    range_cols = or_cols[start_i:end_i + 1]
    n = len(range_cols)
    col_index = d.number_input("Column index", min_value=1, max_value=n, value=min(12, n), step=1,
                               help="Counted from the first column of the range, like VLOOKUP.")
    if n < 12:
        st.caption(f"Your range has only {n} columns, so column index 12 is not available. "
                   "Widen the range (choose an earlier start or a later end).")
    result_col = range_cols[col_index - 1]

    formula = (f"=VLOOKUP({col_letter(tr_cols.index(look_col))}2, "
               f"Original!${col_letter(start_i)}:${col_letter(end_i)}, {col_index}, 0)")
    st.code(formula, language="text")
    st.caption(f"Column {col_index} of this range is “{result_col}”. Match type 0 = exact match "
               "(case-insensitive, first match wins, like Excel).")
    new_name = st.text_input("Name of the new column in the test run sheet", value=result_col,
                             key=f"vl_name_{result_col}")

    # ---- run the lookup
    okeys = norm_key(orig[start])
    mapping = pd.Series(orig[result_col].values, index=okeys.values)
    mapping = mapping[mapping.index.notna()]
    mapping = mapping[~mapping.index.duplicated(keep="first")]
    tkeys = norm_key(tr[look_col])
    matched = tkeys.isin(mapping.index)
    result = tkeys.map(mapping).where(matched, "#N/A")

    section("3 · Result")
    kpi_row([
        ("Test run rows", f"{len(tr):,}", INDIGO, f"lookup column: {short(look_col, 24)}"),
        ("Original rows", f"{len(orig):,}", TEAL, f"key column: {short(start, 24)}"),
        ("Matched", f"{int(matched.sum()):,}", GROUP_COLOR["Pass"],
         f"{matched.mean() * 100:.1f}% of test run rows"),
        ("Not found (#N/A)", f"{int((~matched).sum()):,}", GROUP_COLOR["Fail"],
         "test case ID missing in original"),
    ])
    preview = tr.copy()
    preview[new_name or result_col] = result
    st.dataframe(preview, hide_index=True)

    b1, b2, b3, _ = st.columns([1.2, 1.2, 1.2, 2])
    if b1.button("✔ Apply to test run sheet", type="primary"):
        updated = tr.copy()
        updated[new_name or result_col] = result
        applied = [a_ for a_ in st.session_state.get("vl_applied", [])
                   if a_["name"] != (new_name or result_col)]
        applied.append({"name": new_name or result_col, "formula": formula})
        st.session_state.update(tr_df=updated, vl_applied=applied,
                                flash=f"Added column “{new_name or result_col}” to the test run "
                                      f"sheet ({int(matched.sum())} matched, "
                                      f"{int((~matched).sum())} not found).")
        st.rerun()
    b2.download_button("⬇ Download test run sheet", to_excel_bytes(st.session_state.tr_df),
                       file_name="testrun_with_vlookup.xlsx")
    if b3.button("↺ Reset added columns"):
        st.session_state.update(tr_df=st.session_state.tr_orig.copy(), vl_applied=[],
                                flash="Removed all VLOOKUP columns.")
        st.rerun()

    applied = st.session_state.get("vl_applied", [])
    if applied:
        html_block("".join(f'<span class="chk">➕ {esc(a_["name"])}</span>' for a_ in applied))
        st.caption("These columns are now part of the test run sheet and will be used in Upload to CB.")


# ------------------------------------------------------------------ page: upload to CB
def page_cb():
    page_header("Upload to CB",
                "Download the finished test run sheet, paste your CB link and jump straight to it.")
    tr = st.session_state.get("tr_df")
    if tr is None:
        st.warning("Upload a test run sheet first (option 1 or 2).")
        return
    applied = st.session_state.get("vl_applied", [])
    kpi_row([
        ("Test run sheet", short(st.session_state.tr_name), INDIGO, "ready to upload"),
        ("Rows", f"{len(tr):,}", TEAL, f"{len(tr.columns)} columns"),
        ("VLOOKUP columns", str(len(applied)), SKY,
         ", ".join(a["name"] for a in applied)[:40] if applied else "none added"),
    ])

    section("1 · Download the sheet you will upload")
    d1, d2, _ = st.columns([1, 1, 2])
    base_name = os.path.splitext(st.session_state.tr_name)[0]
    d1.download_button("⬇ Excel (.xlsx)", to_excel_bytes(tr), file_name=f"{base_name}_final.xlsx")
    d2.download_button("⬇ CSV (.csv)", tr.to_csv(index=False).encode("utf-8-sig"),
                       file_name=f"{base_name}_final.csv")

    section("2 · Paste your CB link and press Upload")
    link = st.text_input("CB link", key="cb_link",
                         placeholder="https://codebeamer.company.com/cb/...  (the page where the test run sheet is uploaded)")
    link = link.strip()
    valid_link = link.lower().startswith(("http://", "https://"))
    if link and not valid_link:
        st.error("The link must start with http:// or https://")
    st.link_button("☁️  Upload to CB  ↗", link if valid_link else "https://", type="primary",
                   disabled=not valid_link)
    st.caption("Pressing Upload opens your CB link in a new tab. Upload the sheet you downloaded "
               "above on that page.")

    with st.expander("Advanced: send every row directly through the CB REST API"):
        st.caption("Optional. Creates one tracker item per row. Needs your CB server URL, tracker "
                   "ID and credentials. Keep “Dry run” ticked to preview without sending.")
        a1, a2 = st.columns(2)
        base_url = a1.text_input("CB server URL", placeholder="https://codebeamer.company.com/cb")
        tracker_id = a2.text_input("Tracker ID")
        a3, a4 = st.columns(2)
        cb_user = a3.text_input("CB username")
        cb_pass = a4.text_input("CB password / API token", type="password")
        name_col = st.selectbox("Column used as item Name", list(tr.columns), key="api_name")
        desc_cols = st.multiselect("Columns added to Description",
                                   [c for c in tr.columns if c != name_col], key="api_desc")
        dry_run = st.checkbox("Dry run (do not send, only preview)", value=True)
        if st.button("Start API upload"):
            if not dry_run and not (base_url and tracker_id and cb_user and cb_pass):
                st.error("Fill in the server URL, tracker ID and credentials.")
                return
            url = f"{base_url.rstrip('/')}/rest/v3/trackers/{tracker_id}/items"
            bar = st.progress(0.0)
            ok, failed, errors, payload = 0, 0, [], {}
            for i, (_, row) in enumerate(tr.iterrows(), start=1):
                payload = {
                    "name": str(row[name_col]),
                    "description": "\n".join(f"{c}: {row[c]}" for c in desc_cols),
                }
                if dry_run:
                    ok += 1
                else:
                    try:
                        r = requests.post(url, json=payload, auth=(cb_user, cb_pass), timeout=30)
                        if r.status_code in (200, 201):
                            ok += 1
                        else:
                            failed += 1
                            errors.append({"row": i, "status": r.status_code,
                                           "response": r.text[:200]})
                    except requests.RequestException as exc:
                        failed += 1
                        errors.append({"row": i, "status": "error", "response": str(exc)})
                bar.progress(i / len(tr))
            kpi_row([("Would upload" if dry_run else "Uploaded", f"{ok:,}", GROUP_COLOR["Pass"], ""),
                     ("Failed", f"{failed:,}", GROUP_COLOR["Fail"], "")])
            if errors:
                st.dataframe(pd.DataFrame(errors), hide_index=True)
            if dry_run:
                st.info("Dry run only. Untick “Dry run” to send the rows to CB.")
                st.json({"url": url, "example_payload": payload})


