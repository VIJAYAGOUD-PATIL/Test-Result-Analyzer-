class Dashboard(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Dashboard")
        self.geometry("620x400")
        self.resizable(False, False)
        self.configure(bg=PALETTE["bg"])
        self._build_ui()

    def _build_ui(self):
        header = tk.Frame(self, bg=PALETTE["bg"])
        header.pack(fill="x", padx=PAD * 2, pady=(PAD * 2, PAD))
        tk.Label(header, text="Dashboard", font=FONT_TITLE,
                 bg=PALETTE["bg"], fg=PALETTE["text"]).pack(anchor="w")
        tk.Label(header, text="Choose a tool to continue", font=FONT_SUBTLE,
                 bg=PALETTE["bg"], fg=PALETTE["muted"]).pack(anchor="w", pady=(2, 0))

        cards = tk.Frame(self, bg=PALETTE["bg"])
        cards.pack(expand=True, fill="both", padx=PAD * 2, pady=(0, PAD * 2))
        # Two equal-width columns so both cards always match in size.
        cards.grid_columnconfigure(0, weight=1, uniform="card")
        cards.grid_columnconfigure(1, weight=1, uniform="card")
        cards.grid_rowconfigure(0, weight=1)

        self._build_card(
            cards,
            title="Excel / CSV Viewer",
            desc="Upload a file, view it like Excel, pick a status "
                 "column and get Pass / Fail / Not Testable / Blocked counts.",
            color=PALETTE["primary"],
            command=self.open_excel_viewer,
        ).grid(row=0, column=0, sticky="nsew", padx=(0, GAP))

        self._build_card(
            cards,
            title="SyRs Pass / Fail",
            desc="Upload a file, pick the Verifies column + Result column. "
                 "Duplicates resolve by priority: Blocked > Fail > Pass.",
            color=PALETTE["success"],
            command=self.open_syrs_tool,
        ).grid(row=0, column=1, sticky="nsew", padx=(GAP, 0))

    def _build_card(self, parent, title, desc, color, command):
        card = tk.Frame(parent, bg=PALETTE["surface"], bd=1, relief="solid",
                         highlightbackground=PALETTE["border"], highlightthickness=1)

        # A colored top accent strip ties the card to its "Open" button.
        tk.Frame(card, bg=color, height=4).pack(fill="x", side="top")

        body = tk.Frame(card, bg=PALETTE["surface"])
        body.pack(fill="both", expand=True, padx=20, pady=18)

        tk.Label(body, text=title, font=FONT_CARD_H,
                 bg=PALETTE["surface"], fg=PALETTE["text"],
                 anchor="w", justify="left").pack(fill="x", pady=(0, 8))
        tk.Label(body, text=desc, font=FONT_BODY, bg=PALETTE["surface"],
                 fg=PALETTE["muted"], justify="left", anchor="w",
                 wraplength=230).pack(fill="x", pady=(0, 16))

        make_button(body, "Open  \u2192", command, color).pack(anchor="w")
        return card

    def open_excel_viewer(self):
        ExcelViewerWindow(self)

    def open_syrs_tool(self):
        SyrsPassFailWindow(self)


