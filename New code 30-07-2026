def make_button(parent, text, command, bg, fg="white", width=None):
    """A consistently-styled flat button used across every window."""
    btn = tk.Button(
        parent, text=text, command=command, bg=bg, fg=fg,
        activebackground=bg, activeforeground=fg,
        font=("Segoe UI", 10, "bold"), relief="flat", bd=0,
        padx=16, pady=7, cursor="hand2", width=width,
    )
    return btn


def make_stat_box(parent, label, color):
    """A fixed-size, evenly spaced stat card: LABEL on top, big number below."""
    box = tk.Frame(parent, bg=PALETTE["surface"], bd=1, relief="solid",
                    highlightbackground=PALETTE["border"], highlightthickness=1)
    box.grid_propagate(False)
    box.configure(width=140, height=72)

    tk.Label(box, text=label.upper(), bg=PALETTE["surface"], fg=color,
              font=FONT_STAT_L).pack(pady=(10, 2))
    val_lbl = tk.Label(box, text="0", bg=PALETTE["surface"], fg=PALETTE["text"],
                        font=FONT_STAT_V)
    val_lbl.pack()
    return box, val_lbl


# ----------------------------------------------------------------------
# SHARED FILE-LOADING HELPERS
# (used by both the Excel/CSV Viewer and the SyRs Pass/Fail tool)
# ----------------------------------------------------------------------
def load_file(path):
    """
    Loads an Excel or CSV file robustly, fixing the two most common
    causes of 'columns missing / wrong data':
      1. CSV files using semicolons/tabs instead of commas.
      2. Excel files with a title row (or blank rows) above the
         real header row, which would otherwise get read as headers.
    """
    ext = os.path.splitext(path)[1].lower()
    if ext == ".csv":
        return _load_csv(path)
    return _load_excel(path)


def _load_csv(path):
    # Sniff the delimiter instead of assuming a comma.
    with open(path, "r", newline="", encoding="utf-8-sig", errors="replace") as f:
        sample = f.read(4096)

    delimiter = ","
    try:
        dialect = csv.Sniffer().sniff(sample, delimiters=[",", ";", "\t", "|"])
        delimiter = dialect.delimiter
    except csv.Error:
        pass  # fall back to comma if sniffing fails

    df = pd.read_csv(path, sep=delimiter, dtype=str, encoding="utf-8-sig")
    return _clean_dataframe(df)


def _load_excel(path):
    # Read with no header assumption so we can find the real header
    # row ourselves (skips title rows, logos, blank rows above the
    # actual table).
    raw = pd.read_excel(path, header=None, dtype=str)
    raw = raw.fillna("")

    header_row_idx = 0
    for i, row in raw.iterrows():
        non_empty = sum(1 for v in row if str(v).strip() != "")
        if non_empty >= 2:
            header_row_idx = i
            break

    headers_raw = list(raw.iloc[header_row_idx])
    seen = {}
    headers = []
    for j, h in enumerate(headers_raw):
        name = str(h).strip()
        if not name:
            name = f"Column {j + 1}"
        if name in seen:
            seen[name] += 1
            name = f"{name} ({seen[name]})"
        else:
            seen[name] = 0
        headers.append(name)

    data = raw.iloc[header_row_idx + 1:].copy()
    data.columns = headers
    data = data.reset_index(drop=True)

    # Drop fully blank rows.
    data = data[~(data.apply(lambda r: all(str(v).strip() == "" for v in r), axis=1))]
    data = data.reset_index(drop=True)

    return _clean_dataframe(data)


def _clean_dataframe(df):
    df = df.fillna("")
    df.columns = [str(c).strip() for c in df.columns]
    # Drop rows that are entirely blank.
    df = df[~(df.apply(lambda r: all(str(v).strip() == "" for v in r), axis=1))]
    df = df.reset_index(drop=True)
    return df


def classify_status(value):
    """Return the matching status category name for a cell value, or None."""
    v = str(value).strip().lower()
    if not v:
        return None
    for category, keywords in STATUS_CATEGORIES.items():
        if v in keywords:
            return category
    return None


def guess_column(cols, keywords):
    """Return the first column name whose lowercase text contains any keyword."""
    for c in cols:
        lc = c.lower()
        if any(k in lc for k in keywords):
            return c
    return cols[0] if cols else ""


# ----------------------------------------------------------------------
# LOGIN WINDOW
# ----------------------------------------------------------------------
class LoginWindow(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Login")
        self.geometry("420x320")
        self.resizable(False, False)
        self.configure(bg=PALETTE["bg"])

        self._build_ui()

    def _build_ui(self):
        card = tk.Frame(self, bg=PALETTE["surface"], bd=1, relief="solid",
                         highlightbackground=PALETTE["border"], highlightthickness=1)
        card.place(relx=0.5, rely=0.5, anchor="center", width=340, height=280)

        # A 3-column grid (label col, spacer, field col) keeps everything
        # left-aligned to the exact same x position.
        card.grid_columnconfigure(0, weight=1)

        tk.Label(card, text="Sign In", font=FONT_TITLE,
                 bg=PALETTE["surface"], fg=PALETTE["text"]
                 ).grid(row=0, column=0, sticky="w", padx=28, pady=(26, 4))
        tk.Label(card, text="Use your dashboard credentials", font=FONT_SUBTLE,
                 bg=PALETTE["surface"], fg=PALETTE["muted"]
                 ).grid(row=1, column=0, sticky="w", padx=28, pady=(0, 18))

        tk.Label(card, text="USERNAME", font=FONT_LABEL,
                 bg=PALETTE["surface"], fg=PALETTE["muted"]
                 ).grid(row=2, column=0, sticky="w", padx=28)
        self.entry_user = ttk.Entry(card, font=FONT_BODY)
        self.entry_user.grid(row=3, column=0, sticky="ew", padx=28, pady=(2, 14), ipady=4)

        tk.Label(card, text="PASSWORD", font=FONT_LABEL,
                 bg=PALETTE["surface"], fg=PALETTE["muted"]
                 ).grid(row=4, column=0, sticky="w", padx=28)
        self.entry_pass = ttk.Entry(card, font=FONT_BODY, show="\u2022")
        self.entry_pass.grid(row=5, column=0, sticky="ew", padx=28, pady=(2, 18), ipady=4)

        btn = make_button(card, "Login", self.attempt_login, PALETTE["primary"])
        btn.grid(row=6, column=0, sticky="ew", padx=28, ipady=4)

        self.bind("<Return>", lambda e: self.attempt_login())
        self.entry_user.focus_set()

    def attempt_login(self):
        user = self.entry_user.get().strip()
        pwd = self.entry_pass.get().strip()

        if user == VALID_USERNAME and pwd == VALID_PASSWORD:
            self.destroy()
            app = Dashboard()
            app.mainloop()
        else:
            messagebox.showerror("Login Failed", "Invalid username or password.")
            self.entry_pass.delete(0, tk.END)


