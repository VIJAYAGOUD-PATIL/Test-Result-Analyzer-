class Dashboard(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Dashboard")
        self.geometry("520x360")
        self.resizable(False, False)
        self.configure(bg="#f0f2f5")
        self._build_ui()

    def _build_ui(self):
        tk.Label(self, text="Dashboard", font=("Segoe UI", 18, "bold"),
                 bg="#f0f2f5", fg="#222").pack(pady=(30, 5))
        tk.Label(self, text="Choose a tool to continue",
                 font=("Segoe UI", 10), bg="#f0f2f5", fg="#555").pack(pady=(0, 20))

        cards = tk.Frame(self, bg="#f0f2f5")
        cards.pack(expand=True, fill="both", padx=30)

        self._build_card(
            cards,
            title="Excel / CSV Viewer",
            desc="Upload a file, view it like Excel, pick a status\n"
                 "column and get Pass / Fail / Not Testable / Blocked counts.",
            color="#2563eb",
            command=self.open_excel_viewer,
        ).pack(side="left", expand=True, fill="both", padx=(0, 10))

        self._build_card(
            cards,
            title="SyRs Pass / Fail",
            desc="Upload a file, pick the Verifies column + Result column.\n"
                 "Duplicates are resolved by priority: Blocked > Fail > Pass.",
            color="#16a34a",
            command=self.open_syrs_tool,
        ).pack(side="left", expand=True, fill="both", padx=(10, 0))

    def _build_card(self, parent, title, desc, color, command):
        card = tk.Frame(parent, bg="white", bd=1, relief="solid")

        tk.Label(card, text=title, font=("Segoe UI", 12, "bold"),
                 bg="white", fg="#222").pack(pady=(20, 8), padx=15)
        tk.Label(card, text=desc, font=("Segoe UI", 9), bg="white",
                 fg="#555", justify="left").pack(padx=15, pady=(0, 15))

        tk.Button(card, text="Open", command=command, bg=color, fg="white",
                  font=("Segoe UI", 10, "bold"), relief="flat",
                  padx=12, pady=6, cursor="hand2").pack(pady=(0, 20))
        return card

    def open_excel_viewer(self):
        ExcelViewerWindow(self)

    def open_syrs_tool(self):
        SyrsPassFailWindow(self)


# ----------------------------------------------------------------------
# OPTION 1 - EXCEL / CSV VIEWER (the original tool, now a Toplevel window
# launched from the Dashboard)
# ----------------------------------------------------------------------
class ExcelViewerWindow(tk.Toplevel):
    def __init__(self, master):
        super().__init__(master)
        self.title("Excel / CSV Viewer")
        self.geometry("1100x650")
        self.configure(bg="#f0f2f5")

        self.df = None  # holds the loaded DataFrame

        self._setup_style()
        self._build_top_bar()
        self._build_table()
        self._build_summary_bar()

    # ---------------- Style (this is what makes the table read like Excel) ----------------
    def _setup_style(self):
        style = ttk.Style(self)
        try:
            style.theme_use("clam")
        except tk.TclError:
            pass

        style.configure(
            "Excel.Treeview",
            background="white",
            fieldbackground="white",
            rowheight=24,
            borderwidth=1,
            relief="solid",
            font=("Segoe UI", 10),
        )
        style.configure(
            "Excel.Treeview.Heading",
            background="#e8eaed",
            foreground="#1a1a1a",
            font=("Segoe UI", 10, "bold"),
            relief="raised",
            borderwidth=1,
        )
        style.map(
            "Excel.Treeview",
            background=[("selected", "#cfe2ff")],
            foreground=[("selected", "#000000")],
        )

    # ---------------- UI construction ----------------
    def _build_top_bar(self):
        top = tk.Frame(self, bg="#f8f9fa", pady=8)
        top.pack(fill="x")

        tk.Button(top, text="Upload Excel File", command=self.upload_file,
                  bg="#2563eb", fg="white", font=("Segoe UI", 10, "bold"),
                  relief="flat", padx=12, pady=6, cursor="hand2"
                  ).pack(side="left", padx=10)

        self.lbl_file = tk.Label(top, text="No file loaded", bg="#f8f9fa",
                                  font=("Segoe UI", 9), fg="#555")
        self.lbl_file.pack(side="left", padx=10)

        tk.Label(top, text="Status column:", bg="#f8f9fa",
                 font=("Segoe UI", 9)).pack(side="left", padx=(30, 5))

        self.status_col_var = tk.StringVar()
        self.status_col_combo = ttk.Combobox(top, textvariable=self.status_col_var,
                                              state="readonly", width=25)
        self.status_col_combo.pack(side="left")

        tk.Button(top, text="Count Results", command=self.count_results,
                  bg="#16a34a", fg="white", font=("Segoe UI", 10, "bold"),
                  relief="flat", padx=12, pady=6, cursor="hand2"
                  ).pack(side="left", padx=15)

    def _build_table(self):
        container = tk.Frame(self, bg="#cfcfcf", bd=1)
        container.pack(fill="both", expand=True, padx=10, pady=5)

        vsb = ttk.Scrollbar(container, orient="vertical")
        hsb = ttk.Scrollbar(container, orient="horizontal")

        self.tree = ttk.Treeview(container, show="headings",
                                  yscrollcommand=vsb.set, xscrollcommand=hsb.set,
                                  style="Excel.Treeview")
        vsb.config(command=self.tree.yview)
        hsb.config(command=self.tree.xview)

        vsb.pack(side="right", fill="y")
        hsb.pack(side="bottom", fill="x")
        self.tree.pack(fill="both", expand=True)

        # Banded (striped) rows, like Excel's alternating shading.
        self.tree.tag_configure("evenrow", background="#ffffff")
        self.tree.tag_configure("oddrow", background="#f4f6f8")

        # Status-based row shading, applied on top of banding when a
        # status column has been counted.
        for name, color in STATUS_COLORS.items():
            self.tree.tag_configure(f"status_{name}", background=color)

    def _build_summary_bar(self):
        self.summary_frame = tk.Frame(self, bg="#f0f2f5", pady=10)
        self.summary_frame.pack(fill="x")

        self.summary_labels = {}
        for name, color in SUMMARY_ACCENTS.items():
            box = tk.Frame(self.summary_frame, bg="white", bd=1, relief="solid")
            box.pack(side="left", padx=10, fill="y")

            tk.Label(box, text=name, bg="white", fg=color,
                     font=("Segoe UI", 9, "bold")).pack(padx=15, pady=(5, 0))
            val_lbl = tk.Label(box, text="0", bg="white", fg="#111",
                                font=("Segoe UI", 16, "bold"))
            val_lbl.pack(padx=15, pady=(0, 5))
            self.summary_labels[name] = val_lbl

    # ---------------- Logic ----------------
    def upload_file(self):
        path = filedialog.askopenfilename(
            title="Select Excel or CSV File",
            filetypes=[
                ("Excel/CSV files", "*.xlsx *.xls *.xlsm *.csv"),
                ("Excel files", "*.xlsx *.xls *.xlsm"),
                ("CSV files", "*.csv"),
            ]
        )
        if not path:
            return

        try:
            self.df = load_file(path)
        except Exception as e:
            messagebox.showerror("Error", f"Could not read the file:\n{e}")
            return

        if self.df is None or self.df.empty:
            messagebox.showwarning("Empty File", "No data was found in that file.")
            return

        self.lbl_file.config(text=os.path.basename(path))
        self._populate_table()
        self._populate_status_columns()
        self._reset_summary()

        # Auto-run the count right after loading, for convenience.
        self.count_results()

    def _populate_table(self):
        self.tree.delete(*self.tree.get_children())
        columns = list(self.df.columns)
        self.tree["columns"] = columns

        for col in columns:
            self.tree.heading(col, text=col, anchor="center")
            longest = max(
                [len(str(col))] + [len(str(v)) for v in self.df[col].astype(str).values[:500]]
            )
            width = min(MAX_COL_WIDTH, max(MIN_COL_WIDTH, longest * CHAR_PIXEL_WIDTH))
            self.tree.column(col, width=width, anchor="w", stretch=False)

        for idx, (_, row) in enumerate(self.df.iterrows()):
            band_tag = "evenrow" if idx % 2 == 0 else "oddrow"
            self.tree.insert("", "end", iid=str(idx), values=list(row), tags=(band_tag,))

    def _populate_status_columns(self):
        cols = list(self.df.columns)
        self.status_col_combo["values"] = cols
        guess = guess_column(cols, ["status", "result"])
        self.status_col_var.set(guess)

    def _reset_summary(self):
        for lbl in self.summary_labels.values():
            lbl.config(text="0")

    def count_results(self):
        if self.df is None:
            messagebox.showwarning("No Data", "Please upload an Excel file first.")
            return

        col = self.status_col_var.get()
        if not col or col not in self.df.columns:
            messagebox.showwarning("No Column", "Please select a valid status column.")
            return

        counts = {k: 0 for k in STATUS_CATEGORIES}
        unmatched = 0

        for idx, value in self.df[col].items():
            category = classify_status(value)
            band_tag = "evenrow" if idx % 2 == 0 else "oddrow"
            if category:
                counts[category] += 1
                self.tree.item(str(idx), tags=(band_tag, f"status_{category}"))
            else:
                if str(value).strip():
                    unmatched += 1
                self.tree.item(str(idx), tags=(band_tag,))

        total = sum(counts.values())
        for name, val in counts.items():
            self.summary_labels[name].config(text=str(val))
        self.summary_labels["Total"].config(text=str(total))

        if unmatched:
            messagebox.showinfo(
                "Note",
                f"{unmatched} row(s) had a value in '{col}' that didn't match "
                f"Pass/Fail/Not Testable/Blocked and were skipped.\n\n"
                f"You can edit STATUS_CATEGORIES near the top of the script "
                f"to add more synonyms if needed."
            )


