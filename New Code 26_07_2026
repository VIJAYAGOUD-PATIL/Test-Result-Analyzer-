        self.summary_labels = {}
        for name, color in SYRS_SUMMARY_ACCENTS.items():
            box = tk.Frame(summary_frame, bg="white", bd=1, relief="solid")
            box.pack(side="left", padx=10, fill="y")

            tk.Label(box, text=name, bg="white", fg=color,
                     font=("Segoe UI", 9, "bold")).pack(padx=15, pady=(5, 0))
            val_lbl = tk.Label(box, text="0", bg="white", fg="#111",
                                font=("Segoe UI", 16, "bold"))
            val_lbl.pack(padx=15, pady=(0, 5))
            self.summary_labels[name] = val_lbl

        # ---- Verifies name lists, one column per final status ----
        lists_frame = tk.Frame(bottom, bg="#f0f2f5", pady=6)
        lists_frame.pack(fill="both", expand=True)

        self.list_boxes = {}
        for name, color in SYRS_SUMMARY_ACCENTS.items():
            if name == "Total":
                continue
            col_frame = tk.Frame(lists_frame, bg="white", bd=1, relief="solid")
            col_frame.pack(side="left", expand=True, fill="both", padx=10)

            tk.Label(col_frame, text=f"{name} Verifies", bg="white", fg=color,
                     font=("Segoe UI", 10, "bold")).pack(pady=(8, 4))

            list_container = tk.Frame(col_frame, bg="white")
            list_container.pack(fill="both", expand=True, padx=8, pady=(0, 8))

            sb = ttk.Scrollbar(list_container, orient="vertical")
            lb = tk.Listbox(list_container, font=("Segoe UI", 9),
                             yscrollcommand=sb.set, height=8,
                             relief="flat", bd=0, highlightthickness=1,
                             highlightbackground="#ddd")
            sb.config(command=lb.yview)
            sb.pack(side="right", fill="y")
            lb.pack(side="left", fill="both", expand=True)

            self.list_boxes[name] = lb

    # ---------------- Logic ----------------
    def upload_file(self):
        path = filedialog.askopenfilename(
            title="Select Excel or CSV File",
            filetypes=[
                ("Excel/CSV files", "*.xlsx *.xls *.xlsm *.csv"),
                ("Excel files", "*.xlsx *.xls *.xlsm"),
                ("CSV files", "*.csv"),
            ]
        )
        if not path:
            return

        try:
            self.df = load_file(path)
        except Exception as e:
            messagebox.showerror("Error", f"Could not read the file:\n{e}")
            return

        if self.df is None or self.df.empty:
            messagebox.showwarning("Empty File", "No data was found in that file.")
            return

        self.lbl_file.config(text=os.path.basename(path))
        self._populate_column_pickers()
        self._populate_raw_table()
        self._reset_summary()

    def _populate_column_pickers(self):
        cols = list(self.df.columns)
        self.verify_col_combo["values"] = cols
        self.result_col_combo["values"] = cols

        self.verify_col_var.set(guess_column(cols, ["verifies", "verify", "requirement", "syrs", "id"]))
        self.result_col_var.set(guess_column(cols, ["result", "status"]))

    def _populate_raw_table(self):
        self.tree.delete(*self.tree.get_children())
        columns = list(self.df.columns)
        self.tree["columns"] = columns

        for col in columns:
            self.tree.heading(col, text=col, anchor="center")
            longest = max(
                [len(str(col))] + [len(str(v)) for v in self.df[col].astype(str).values[:500]]
            )
            width = min(MAX_COL_WIDTH, max(MIN_COL_WIDTH, longest * CHAR_PIXEL_WIDTH))
            self.tree.column(col, width=width, anchor="w", stretch=False)

        for idx, (_, row) in enumerate(self.df.iterrows()):
            band_tag = "evenrow" if idx % 2 == 0 else "oddrow"
            self.tree.insert("", "end", iid=str(idx), values=list(row), tags=(band_tag,))

    def _reset_summary(self):
        for lbl in self.summary_labels.values():
            lbl.config(text="0")
        for lb in self.list_boxes.values():
            lb.delete(0, tk.END)

    def _merge_status(self, raw_status):
        """Fold Not Testable + Blocked into a single 'Blocked' bucket."""
        if raw_status in ("Not Testable", "Blocked"):
            return "Blocked"
        return raw_status  # "Pass", "Fail", or None

    def analyze(self):
        if self.df is None:
            messagebox.showwarning("No Data", "Please upload a file first.")
            return

        verify_col = self.verify_col_var.get()
        result_col = self.result_col_var.get()

        if not verify_col or verify_col not in self.df.columns:
            messagebox.showwarning("No Column", "Please select a valid Verifies column.")
            return
        if not result_col or result_col not in self.df.columns:
            messagebox.showwarning("No Column", "Please select a valid Result column.")
            return
        if verify_col == result_col:
            messagebox.showwarning("Same Column", "Verifies column and Result column must be different.")
            return

        # ---- Step 1: classify every row, merging Not Testable + Blocked ----
        row_merged_status = []          # merged status per row, in row order
        statuses_seen_per_id = {}       # verify_id -> set of merged statuses
        occurrences_per_id = {}         # verify_id -> row count (to spot duplicates)
        unmatched = 0

        for idx, row in self.df.iterrows():
            vid = str(row[verify_col]).strip()
            raw = classify_status(row[result_col])
            merged = self._merge_status(raw)
            row_merged_status.append(merged)

            if merged is None and str(row[result_col]).strip():
                unmatched += 1

            if vid:
                occurrences_per_id[vid] = occurrences_per_id.get(vid, 0) + 1
                if merged:
                    statuses_seen_per_id.setdefault(vid, set()).add(merged)

        # ---- Step 2: resolve ONE final verdict per Verifies id ----
        # Each id is decided individually (its own set of statuses), not by
        # comparing it against every other id. Priority: Blocked > Fail > Pass.
        final_status_per_id = {}
        for vid, statuses in statuses_seen_per_id.items():
            for level in SYRS_PRIORITY:
                if level in statuses:
                    final_status_per_id[vid] = level
                    break

        # ---- Step 3: remove duplicates -> one unique, final list per bucket ----
        pass_ids = sorted({v for v, s in final_status_per_id.items() if s == "Pass"})
        fail_ids = sorted({v for v, s in final_status_per_id.items() if s == "Fail"})
        blocked_ids = sorted({v for v, s in final_status_per_id.items() if s == "Blocked"})

        # ---- Step 4: conditional formatting on the raw table ----
        # - Row background reflects the FINAL verdict of that row's Verifies id.
        # - Rows whose Verifies id occurs more than once (duplicates) get an
        #   extra highlight so conflicting/duplicate test rows stand out.
        for idx, row in self.df.iterrows():
            vid = str(row[verify_col]).strip()
            band_tag = "evenrow" if idx % 2 == 0 else "oddrow"
            tags = [band_tag]

            final = final_status_per_id.get(vid)
            if final:
                tags.append(f"final_{final}")
            if vid and occurrences_per_id.get(vid, 0) > 1:
                tags.append("duplicate")

            self.tree.item(str(idx), tags=tuple(tags))

        # ---- Step 5: update counts ----
        self.summary_labels["Pass"].config(text=str(len(pass_ids)))
        self.summary_labels["Fail"].config(text=str(len(fail_ids)))
        self.summary_labels["Blocked"].config(text=str(len(blocked_ids)))
        self.summary_labels["Total"].config(text=str(len(final_status_per_id)))

        # ---- Step 6: update the Verifies-name lists ----
        self.list_boxes["Pass"].delete(0, tk.END)
        self.list_boxes["Fail"].delete(0, tk.END)
        self.list_boxes["Blocked"].delete(0, tk.END)
        for vid in pass_ids:
            self.list_boxes["Pass"].insert(tk.END, vid)
        for vid in fail_ids:
            self.list_boxes["Fail"].insert(tk.END, vid)
        for vid in blocked_ids:
            self.list_boxes["Blocked"].insert(tk.END, vid)

        dup_count = sum(1 for c in occurrences_per_id.values() if c > 1)
        msg_parts = []
        if dup_count:
            msg_parts.append(
                f"{dup_count} Verifies id(s) appeared on more than one row and were "
                f"resolved to a single final verdict (priority: Blocked > Fail > Pass)."
            )
        if unmatched:
            msg_parts.append(
                f"{unmatched} row(s) had a value in '{result_col}' that didn't match "
                f"Pass/Fail/Not Testable/Blocked and were ignored."
            )
        if msg_parts:
            messagebox.showinfo("Note", "\n\n".join(msg_parts))


