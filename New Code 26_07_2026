DUPLICATE_HIGHLIGHT = "#fff3b0"   # light yellow

# Priority used to decide the ONE final verdict for a Verifies id that
# appears on more than one row: Blocked beats Fail beats Pass.
SYRS_PRIORITY = ["Blocked", "Fail", "Pass"]

